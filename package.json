{
  "name": "aios-core",
  "version": "1.0.0",
  "description": "AIOS Core — agent reliability kernel with task contracts, evidence gates, deterministic verification, replay, and rollback.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/kernel/runtime.js",
  "types": "dist/kernel/runtime.d.ts",
  "bin": {
    "aios": "dist/cli/aios.js"
  },
  "exports": {
    ".": {
      "types": "./dist/kernel/runtime.d.ts",
      "default": "./dist/kernel/runtime.js"
    },
    "./kernel": {
      "types": "./dist/kernel/schema/index.d.ts",
      "default": "./dist/kernel/schema/index.js"
    },
    "./reliability": {
      "types": "./dist/kernel/reliability.d.ts",
      "default": "./dist/kernel/reliability.js"
    },
    "./eval": {
      "types": "./dist/kernel/eval.d.ts",
      "default": "./dist/kernel/eval.js"
    },
    "./codex": {
      "types": "./dist/cli/codex.d.ts",
      "default": "./dist/cli/codex.js"
    },
    "./codex/evidence": {
      "types": "./dist/cli/codex_evidence.d.ts",
      "default": "./dist/cli/codex_evidence.js"
    },
    "./policy": {
      "types": "./dist/governor/policy.d.ts",
      "default": "./dist/governor/policy.js"
    },
    "./governor": {
      "types": "./dist/governor/scope.d.ts",
      "default": "./dist/governor/scope.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "scripts/codex-shadow-capture.mjs"
  ],
  "scripts": {
    "arch-guard": "node scripts/arch-guard.mjs",
    "pretest": "node scripts/arch-guard.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/arch-guard.mjs && tsc --noEmit && vitest run",
    "codex:shadow-capture": "node scripts/codex-shadow-capture.mjs"
  },
  "keywords": [
    "agent-reliability",
    "agent-ci",
    "agent",
    "runtime",
    "evidence-gate",
    "regression",
    "project-memory",
    "software-engineering"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamanager2012/aios-core.git"
  },
  "homepage": "https://github.com/kamanager2012/aios-core#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.0.0",
    "madge": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
